# .env.production -- used by `npm run build` (vite mode=production).
# Absolute URLs: the built bundle is served from the CRM domain, not from a
# Vite dev server, so there is no proxy to fall back on.
VITE_AUTH_BASE_URL=https://admin.celiyo.com/api
VITE_CRM_BASE_URL=https://crm.celiyo.com/api
VITE_HMS_BASE_URL=https://hms.celiyo.com/api
VITE_WHATSAPP_BASE_URL=https://whatsappapi.celiyo.com/api
VITE_WHATSAPP_WS_URL=https://whatsappapi.celiyo.com/api
VITE_WHATSAPP_EXTERNAL_BASE_URL=https://whatsappapi.celiyo.com/api
VITE_LARAVEL_APP_URL=https://whatsappapi.celiyo.com
